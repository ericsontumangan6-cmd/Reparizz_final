<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar: Back Button & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_map"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_back_button"
                android:text="←"
                android:textColor="@color/primary_accent"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺️ Google Maps - Malolos, Bulacan"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RepaRizz Authorized Repair Shop Directory"
                    android:textColor="@color/primary_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Google Maps View Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Floating Search Bar (Google Maps Style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <EditText
                    android:id="@+id/et_map_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search Malolos Shops (e.g. FBN, BulSU)..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:padding="8dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_map_search"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_gps_recenter"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textColor="@color/primary_accent"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Google Maps Category Quick Chips Bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_utilities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_electronics"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="🛠️ RepaRizz Shops"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cleaning"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏥 Hospitals / Clinics"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_plumbing"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏫 BulSU &amp; Schools"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Light Google Maps Interactive Canvas (Malolos, Bulacan Map Area) -->
            <FrameLayout
                android:id="@+id/map_viewport"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="8dp"
                android:background="#E5E3DF"
                android:clipChildren="true"
                android:clipToPadding="true">

                <!-- Vector Map Styling representing Malolos, Bulacan Roads & Landforms -->
                <RelativeLayout
                    android:id="@+id/map_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Waterways & Pamarawan River Streams -->
                    <View
                        android:layout_width="120dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:background="#AADAFF" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="40dp"
                        android:background="#AADAFF" />

                    <!-- Parks / Greenery Area (The Pond Leisure Farm / Malolos Park) -->
                    <View
                        android:layout_width="140dp"
                        android:layout_height="80dp"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="80dp"
                        android:background="#C5E8C5" />

                    <!-- MacArthur Highway Line (Diagonal Route 2) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="110dp"
                        android:background="#FFD275" />

                    <!-- NLEX Expressway Line -->
                    <View
                        android:layout_width="6dp"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="60dp"
                        android:background="#7FA3C9" />

                    <!-- Map Barangay Text Labels -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="15dp"
                        android:text="MALOLOS"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="140dp"
                        android:layout_marginTop="25dp"
                        android:text="Longos"
                        android:textColor="#777777"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="190dp"
                        android:layout_marginTop="50dp"
                        android:text="Mojon"
                        android:textColor="#777777"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="150dp"
                        android:layout_marginTop="140dp"
                        android:text="Guinhawa"
                        android:textColor="#777777"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="180dp"
                        android:text="Paombong"
                        android:textColor="#666666"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Landmark Pins from Malolos Map -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="130dp"
                        android:layout_marginTop="125dp"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="#FF4081"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="🏥 Robinsons Malolos"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="40dp"
                        android:layout_marginTop="150dp"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="#7E57C2"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="⛪ Barasoain Church"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />

                    <!-- Map Marker 1: RepaRizz HQ & FBN IT Solution (Crossing) -->
                    <LinearLayout
                        android:id="@+id/pin_fbn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="150dp"
                        android:layout_marginTop="80dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:backgroundTint="#EA4335"
                            android:elevation="4dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="📍 RepaRizz HQ / FBN IT Solution"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔴"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- Map Marker 2: RepaRizz BulSU Branch (Guinhawa) -->
                    <LinearLayout
                        android:id="@+id/pin_hub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="200dp"
                        android:layout_marginTop="145dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:backgroundTint="#34A853"
                            android:elevation="4dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="📍 RepaRizz (BulSU Branch)"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Map Marker 3: Capitol Electronics Care (Catmon) -->
                    <LinearLayout
                        android:id="@+id/pin_capitol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="70dp"
                        android:layout_marginTop="200dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:backgroundTint="#FBBC05"
                            android:elevation="4dp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp"
                            android:text="📍 Capitol Tech (Catmon)"
                            android:textColor="#222222"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟡"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Map Marker 4: Central Bulacan Care (Mabolo) -->
                    <LinearLayout
                        android:id="@+id/pin_mabolo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="190dp"
                        android:layout_marginEnd="40dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:backgroundTint="#4285F4"
                            android:elevation="4dp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="3dp"
                            android:text="📍 Central Bulacan (Mabolo)"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔵"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Google Maps Watermark Credits -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="Google"
                        android:textColor="#444444"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="Map data ©2026 Google"
                        android:textColor="#666666"
                        android:textSize="9sp" />
                </RelativeLayout>

                <!-- Floating Zoom Level Badge (Top Right) -->
                <TextView
                    android:id="@+id/tv_zoom_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_status_badge"
                    android:backgroundTint="#CC10141D"
                    android:elevation="6dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Zoom: 1.0x"
                    android:textColor="#35D6C3"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Floating Zoom Controls Container (Bottom Right) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="24dp"
                    android:elevation="6dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_zoom_in"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:backgroundTint="#EEFFFFFF"
                        android:text="➕"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_zoom_out"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:backgroundTint="#EEFFFFFF"
                        android:text="➖"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Google Place Details Card (Selected Shop Information) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_shop_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RepaRizz HQ / FBN IT Solution"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_shop_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="⭐ 4.9 (128 Google Reviews) • Gadget &amp; Electronics Care"
                        android:textColor="@color/status_diagnosing"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_shop_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_badge"
                    android:backgroundTint="@color/status_completed"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="✓ VERIFIED AUTHORIZED SHOP"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_shop_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🏷️ Category: Electronics, IT Solutions &amp; Smartphone Repair"
                android:textColor="@color/primary_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_shop_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📍 Address: MacArthur Highway, Malolos Crossing, Malolos, 3000 Bulacan, Philippines"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_shop_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📞 Contact: (+63) 917-123-4567 | fbn.malolos@gmail.com"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_shop_services"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🛠️ Core Services: Electronics Repair, Motherboard Diagnostics, Screen &amp; Battery Replacement, Ultrasonic Cleaning"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_shop_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="⏰ Operating Hours: Mon - Sat: 8:00 AM - 6:00 PM"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Google Maps Style Quick Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_action_call"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary_accent"
                    android:text="📞 Call Shop"
                    android:textColor="@color/bg_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_action_directions"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="📍 Directions"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/card_dark_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_action_jobs"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="📋 Repair Queue"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/card_dark_stroke" />
            </LinearLayout>

            <!-- Admin Control Actions (Approve / Reject / Update) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ ADMIN Controls for Selected Shop"
                    android:textColor="@color/status_awaiting_approval"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_approve"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/status_completed"
                        android:text="✓ Approve"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_reject"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/status_rejected"
                        android:text="✗ Reject"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_update"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:text="✏️ Edit Info"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/card_dark_stroke" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Shop Selection Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏢 Quick Select Malolos Repair Shop"
                android:textColor="@color/primary_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2"
                android:rowCount="2">

                <com.google.android.material.button.MaterialButton
